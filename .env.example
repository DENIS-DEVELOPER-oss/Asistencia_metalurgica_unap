# ---------------------------------------------------------------
# Copia este archivo como .env y ajusta los valores
# ---------------------------------------------------------------

# Clave secreta de Django (genera una nueva para producción)
SECRET_KEY=django-inseguro-cambia-esta-clave-en-produccion

# DEBUG=True mientras se desarrolla. En uso real SIEMPRE False: con True
# cualquier error muestra en pantalla la configuración y la contraseña de
# la base de datos.
DEBUG=True

# Ponlo en True solo si el sistema queda detrás de HTTPS. Con True sobre
# HTTP no se puede iniciar sesión, porque las cookies quedan marcadas
# como «solo por conexión segura».
USAR_HTTPS=False

# --------------------------- Seguridad ---------------------------
# Minutos que puede quedarse quieta una sesion antes de caducar. La
# cuenta se reinicia con cada pantalla que se abre, asi que son minutos
# SIN USAR el sistema: una clase entera no se corta. Bajalo si la PC del
# aula la usan varias personas.
MINUTOS_DE_INACTIVIDAD=180

# Ponlo en True solo si delante hay un proxy (nginx, IIS, Cloudflare)
# que termina el HTTPS. Solo entonces se hace caso a las cabeceras que
# ese proxy anade, con las que se conoce la IP real de quien entra. Sin
# proxy delante esas cabeceras las escribe cualquiera, asi que con False
# se ignoran.
DETRAS_DE_PROXY=False

# Hosts permitidos, separados por coma.
# Agrega aquí la IP de tu PC si vas a entrar desde el celular.
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------- Base de datos -------------------------
# DB_USER/DB_PASSWORD los rellena  manage.py crear_usuario_mysql  con una
# cuenta propia de la aplicacion: puede leer y escribir filas de
# asistencia_unap y nada mas. Entrar como root significa que cualquier
# fallo de la aplicacion tendria permiso para borrar la base entera, y que
# cualquier programa de esta PC puede cambiar la asistencia saltandose las
# reglas del sistema.
DB_NAME=asistencia_unap
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --------------------------- Reglas ------------------------------
# Porcentaje de faltas a partir del cual el alumno queda en riesgo de
# inhabilitación (30 = más del 30% de faltas inhabilita)
UMBRAL_INHABILITACION=30
